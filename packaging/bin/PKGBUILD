# Maintainer: hakergeniusz
# Prebuilt-binary PKGBUILD: installs the release .tar.zst asset.
# sha256sums is the checksum of the v0.2.8 release asset; keep it in sync on bumps.
pkgname=rustfetch-bin
pkgver=0.2.8
pkgrel=1
pkgdesc='Fastfetch, rewritten in Rust (prebuilt binary)'
arch=('x86_64')
url='https://github.com/hakergeniusz/rustfetch'
license=('MIT')
# libc, libm and libgcc_s come from glibc and gcc-libs. fastfetch is NOT needed.
depends=('glibc' 'gcc-libs')
provides=('rustfetch')
conflicts=('rustfetch')
_TARBALL="rustfetch-${pkgver}-x86_64-unknown-linux-gnu.tar.zst"
source=("$_TARBALL::https://github.com/hakergeniusz/rustfetch/releases/download/v${pkgver}/${_TARBALL}")
sha256sums=('db534570b636864aec73dfa316b5e9fdbdfd4ed1d0d8d54ef4b9cbec81d7ecd3')

package() {
  tar --zstd -xf "$_TARBALL" -C "$srcdir"
  install -Dm755 "$srcdir/rustfetch" "$pkgdir/usr/bin/rustfetch"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/completions/_rustfetch" "$pkgdir/usr/share/zsh/site-functions/_rustfetch"
}
