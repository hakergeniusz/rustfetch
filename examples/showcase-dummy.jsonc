{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  // Illustrative popular-spec data for README screenshots — NOT the host's real values.
  "logo": {
    "type": "builtin",
    "source": "arch",
    "hyfetch": { "preset": "transgender", "mode": "24bit" }
  },
  "modules": [
    { "type": "custom", "format": "{#cyan}user@ryzen-box{#}" },
    { "type": "custom", "format": "{#cyan}------------------{#}" },
    { "type": "custom", "format": "{#cyan}OS{#}  Arch Linux x86_64" },
    { "type": "custom", "format": "{#cyan}Host{#}  MSI MAG B650 TOMAHAWK WIFI" },
    { "type": "custom", "format": "{#cyan}Kernel{#}  Linux 6.8.4-arch1-1" },
    { "type": "custom", "format": "{#cyan}Uptime{#}  3 hours, 12 mins" },
    { "type": "custom", "format": "{#cyan}Shell{#}  zsh 5.9" },
    { "type": "custom", "format": "{#cyan}Display{#}  LG UltraGear 27\" 2560x1440 @ 165 Hz" },
    { "type": "custom", "format": "{#cyan}CPU{#}  AMD Ryzen 7 7800X3D (8) @ 4.20 GHz" },
    { "type": "custom", "format": "{#cyan}GPU{#}  NVIDIA GeForce RTX 4070 SUPER [Discrete]" },
    { "type": "custom", "format": "{#cyan}Memory{#}  18.42 GiB / 31.34 GiB (58%)" },
    { "type": "custom", "format": "{#cyan}Swap{#}  2.10 GiB / 8.00 GiB (26%)" },
    { "type": "custom", "format": "{#cyan}Disk (/){#}  612 GiB / 1.82 TiB (34%) - btrfs" }
  ]
}
