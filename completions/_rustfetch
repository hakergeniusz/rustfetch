_rustfetch_modules() {
  local -a mods
  mods=(${(f)"$(rustfetch --list-modules 2>/dev/null | sed -nE 's/^[[:space:]]*[0-9]+\)[[:space:]]+([^: ]+).*/\1/p')"})
  (( ${#mods} )) && _describe 'module' mods
}

_rustfetch_logos() {
  local -a logos
  logos=(${(f)"$(rustfetch --list-logos 2>/dev/null | grep -oE '"[^"]+"' | tr -d '"' | sort -u)"})
  (( ${#logos} )) && _describe 'logo' logos
}

_rustfetch_configs() {
  _files -g '*.jsonc' -g '*.json'
}

